# Copie para `.env` e preencha. Todas são OPCIONAIS —
# o site funciona sem nenhuma delas (ver CONTEUDO-PENDENTE.md).

# Domínio final. Afeta URLs canônicas, sitemap e imagens de Open Graph.
# Sem isso, usa https://makley.com.br
PUBLIC_SITE_URL=https://makley.com.br

# Endpoint do formulário de contato Web3Forms
# Sem isso, o formulário abre o cliente de e-mail do visitante (mailto:).
# Exemplos:
#   Web3Forms: https://api.web3forms.com/submit
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_CONTACT_ACCESS_KEY=

# Analytics via PostHog (https://posthog.com — crie um projeto e copie a chave em
# Project Settings > Project API Key). Sem isso, NENHUM script de rastreamento é
# carregado. PUBLIC_POSTHOG_HOST só precisa ser definido se o projeto não estiver
# na região "us" (padrão); veja a região certa nas configurações do projeto.
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com