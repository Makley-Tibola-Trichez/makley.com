---
/**
 * SiteFooter — organism.
 *
 * Doubles as the last conversion point: a recruiter who scrolled this far
 * should not have to scroll back up to find an e-mail address.
 */
import { getRelativeLocaleUrl } from 'astro:i18n';

import type { Profile } from '@domain/profile/profile.entity';
import { getDictionary } from '@i18n/dictionary';
import { resolveLocale } from '@i18n/locales';
import Icon from '@atoms/Icon.astro';
import SocialLinks from '@molecules/SocialLinks.astro';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props as Props;

const year = new Date().getUTCFullYear();

const locale = resolveLocale(Astro.currentLocale);
const { footer: t } = getDictionary(locale);
const brandAriaLabel = t.brandAriaLabel.replace('{name}', profile.name);

// `/#sobre` etc. are absolute, so a visitor on `/en/curriculo` (once that
// page exists) would otherwise land back on the pt-BR home instead of
// staying on their locale — prefixing with the locale-correct root fixes
// that. `/curriculo` and `/projetos` stay unprefixed on purpose: those pages
// are pt-BR-only for now (out of scope for this i18n phase).
const homeHref = getRelativeLocaleUrl(locale, '/');

const SITEMAP = [
  {
    title: t.navGroupTitle,
    links: t.navLinks.map((item) => ({ label: item.label, href: `${homeHref}${item.hash}` })),
  },
  {
    title: t.resourcesGroupTitle,
    links: [
      { label: t.resumeOnlineLink, href: '/curriculo' },
      { label: t.resumePdfLink, href: profile.resumePath },
      { label: t.allProjectsLink, href: '/projetos' },
    ],
  },
] as const;
---

<footer class="footer">
  <div class="footer__glow" aria-hidden="true"></div>

  <div class="u-container u-container--wide">
    <div class="footer__grid">
      <div class="footer__identity">
        <a href={homeHref} class="footer__brand" aria-label={brandAriaLabel}>
          <span class="footer__mark" aria-hidden="true">M</span>
          <span>{profile.name}</span>
        </a>

        <p class="footer__pitch">{profile.headline}</p>

        <a href={profile.mailto} class="footer__email">
          <Icon name="mail" size={16} />
          {profile.email}
        </a>

        <p class="footer__location">
          <Icon name="map-pin" size={14} />
          {profile.location}
        </p>
      </div>

      {
        SITEMAP.map((group) => (
          <nav class="footer__column" aria-label={group.title}>
            <h2 class="footer__column-title">{group.title}</h2>
            <ul class="u-list-reset footer__links">
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="footer__column">
        <h2 class="footer__column-title">{t.findMeTitle}</h2>
        <SocialLinks profile={profile} scope="all" size="sm" showLabels class="footer__socials" />
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {profile.name}. {t.copyrightSuffix}</p>
      <p class="footer__colophon">
        {t.colophonPrefix} <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
        {t.colophonSuffix}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-block-start: var(--space-section);
    padding-block: var(--space-16) var(--space-8);
    border-block-start: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  /* Warm halo bleeding up from the bottom edge — closes the page the same way
     the hero opens it. */
  .footer__glow {
    position: absolute;
    inset-block-end: -60%;
    inset-inline-start: 50%;
    translate: -50% 0;
    width: min(64rem, 120vw);
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--color-accent) 12%, transparent) 0%,
      transparent 62%
    );
    pointer-events: none;
  }

  .footer__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    padding-block-end: var(--space-12);
  }

  /* -------------------------------------------------------------- identity */

  .footer__identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 26rem;
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-lg);
    font-weight: 560;
    letter-spacing: var(--tracking-tight);
  }

  .footer__mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    background: linear-gradient(150deg, var(--color-surface-raised), var(--color-surface));
    box-shadow: var(--highlight-top);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    line-height: 1;
  }

  .footer__pitch {
    margin: 0;
    color: var(--color-text-muted);
    line-height: var(--lh-relaxed);
  }

  .footer__email {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-size: var(--fs-base);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .footer__email:hover {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }

  .footer__location {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-text-faint);
    font-size: var(--fs-sm);
  }

  /* --------------------------------------------------------------- columns */

  .footer__column-title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__links a {
    color: var(--color-text-muted);
    font-size: var(--fs-base);
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .footer__links a:hover {
    color: var(--color-accent);
  }

  .footer__socials {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-1);
    margin-inline-start: calc(var(--space-3) * -1);
  }

  /* ---------------------------------------------------------------- bottom */

  .footer__bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--border-subtle);
    color: var(--color-text-faint);
    font-size: var(--fs-sm);
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__colophon a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer__colophon a:hover {
    color: var(--color-accent);
  }

  @media (min-width: 40rem) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
      gap: var(--space-8);
    }
  }
</style>
