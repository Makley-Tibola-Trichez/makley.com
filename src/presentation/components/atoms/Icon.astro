const {
  name,
  size = 20,
  title,
  class: className,
  strokeWidth = 1.6,
} = Astro.props as Props;

const icon = ICONS[name];
const isBrand = 'fill' in icon && icon.fill === true;
const dimension = typeof size === 'number' ? `${size}px` : size;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={dimension}
  height={dimension}
  class:list={['icon', className]}
  fill={isBrand ? 'currentColor' : 'none'}
  stroke={isBrand ? 'none' : 'currentColor'}
  stroke-width={isBrand ? undefined : strokeWidth}
  stroke-linecap={isBrand ? undefined : 'round'}
  stroke-linejoin={isBrand ? undefined : 'round'}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  focusable="false"
>
  {title && <title>{title}</title>}
  <path d={icon.d} />
</svg>

<style>
  .icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }
</style>
