---
/**
 * Icon — atom.
 *
 * Inline SVG rather than an icon font or a sprite request: Astro renders this
 * server-side, so only the icons actually used end up in the HTML, with zero
 * extra network requests and no FOUT. Brand marks are filled paths (they are
 * trademarks with fixed geometry); UI icons are 1.5px strokes that inherit
 * `currentColor` and scale with the surrounding text.
 *
 * Accessibility: icons are `aria-hidden` by default. Pass a `title` only when
 * the icon carries meaning that no adjacent text already conveys.
 */

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  size?: number | string;
  /** Accessible name. Omit for decorative icons sitting next to a text label. */
  title?: string;
  class?: string;
  strokeWidth?: number;
}

