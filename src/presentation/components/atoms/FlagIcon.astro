---
/**
 * FlagIcon — atom.
 *
 * Unlike `Icon`, flags are inherently multi-colour, so they can't reuse the
 * single-path/`currentColor` system there. Kept intentionally simple —
 * stripes, a canton, a star-less circle — legible at the ~18px size this
 * actually renders at, not a pixel-accurate reproduction.
 */
export type FlagCode = 'BR' | 'US';

interface Props {
  code: FlagCode;
  size?: number;
  /** Accessible name. Omit when adjacent text already names the language. */
  title?: string;
  class?: string;
}

const { code, size = 20, title, class: className } = Astro.props as Props;
const width = size;
const height = Math.round(size * 0.75);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 20 15"
  width={width}
  height={height}
  class:list={['flag-icon', className]}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  focusable="false"
>
  {title && <title>{title}</title>}
  {
    code === 'BR' && (
      <>
        <rect width="20" height="15" fill="#009739" />
        <polygon points="10,2 18.2,7.5 10,13 1.8,7.5" fill="#FEDD00" />
        <circle cx="10" cy="7.5" r="3.1" fill="#002776" />
        <path d="M6.7 7.7a3.5 3.5 0 0 1 6.6-.4" fill="none" stroke="#fff" stroke-width="0.55" />
      </>
    )
  }
  {
    code === 'US' && (
      <>
        <rect width="20" height="15" fill="#fff" />
        <g fill="#B22234">
          <rect y="0" width="20" height="1.15" />
          <rect y="2.31" width="20" height="1.15" />
          <rect y="4.62" width="20" height="1.15" />
          <rect y="6.92" width="20" height="1.15" />
          <rect y="9.23" width="20" height="1.15" />
          <rect y="11.54" width="20" height="1.15" />
          <rect y="13.85" width="20" height="1.15" />
        </g>
        <rect width="8" height="8.08" fill="#002868" />
      </>
    )
  }
</svg>

<style>
  .flag-icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
    border-radius: 3px;
    outline: 1px solid color-mix(in oklab, currentColor 12%, transparent);
    outline-offset: -1px;
    overflow: hidden;
  }
</style>
